<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.infdesk5.quicknotes.ObservableScrollView
            android:id="@+id/note_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="always">

            <LinearLayout
                android:id="@+id/note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/note_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/hint_write"
                    android:inputType="textMultiLine|textCapSentences"
                    android:background="@null"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

            </LinearLayout>

        </com.infdesk5.quicknotes.ObservableScrollView>

        <!-- In-note search bar -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="4dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:background="@null"
                android:padding="8dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:visibility="gone" />
            
            <ImageButton
                android:id="@+id/search_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/arrow_up_float"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous" />

            <ImageButton
                android:id="@+id/search_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/arrow_down_float"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next" />

            <ImageButton
                android:id="@+id/search_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close" />

        </LinearLayout>

        <!-- Note Slot Bar -->
        <com.infdesk5.quicknotes.ui.NoteSlotBar
            android:id="@+id/note_slot_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface" />

        <!-- Custom Bottom Toolbar -->
        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@color/surface"
            android:elevation="4dp"
            android:theme="@android:style/ThemeOverlay.Material.Dark.ActionBar"
            android:popupTheme="@android:style/ThemeOverlay.Material.Dark"
            android:contentInsetStart="0dp"
            android:contentInsetEnd="0dp"
            android:contentInsetLeft="0dp"
            android:contentInsetRight="0dp"
            android:padding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_save"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/save" />

                <ImageButton
                    android:id="@+id/btn_new"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_add"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/new_note" />

                <ImageButton
                    android:id="@+id/btn_search_note"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_search"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_in_note" />

                <TextView
                    android:id="@+id/btn_notes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/notes"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/btn_undo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_undo"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/undo" />

                <ImageButton
                    android:id="@+id/btn_redo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_redo"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/redo" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@android:drawable/ic_menu_manage"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings" />

            </LinearLayout>

        </Toolbar>

    </LinearLayout>

    <!-- Fast Scroller -->
    <FrameLayout
        android:id="@+id/fast_scroller"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|top"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="108dp"
        android:visibility="invisible">

        <View
            android:id="@+id/scroll_track"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/scroll_track" />

        <View
            android:id="@+id/scroll_thumb"
            android:layout_width="8dp"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/scroll_thumb" />

    </FrameLayout>

</FrameLayout>
